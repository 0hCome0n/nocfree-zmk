 config ZMK_KSCAN_DIRECT_POLLING
     bool "Poll for key event triggers instead of using interrupts on direct wired boards."
 
+config ZMK_KSCAN_DEDICATED_WORKQUEUE
+    bool "Run the direct kscan on its own thread instead of the system workqueue."
+    help
+        For boards where a scan is slow (e.g. keys behind I2C expanders), running
+        the scan on the shared system workqueue lets BLE/backlight work queue in
+        front of it; when that backs up the scan slips its deadline and a key
+        release is lost (stuck key), and a bad backlog can starve BLE into a
+        disconnect. A dedicated thread cannot be blocked by that backlog.
+
+config ZMK_KSCAN_DEDICATED_WORKQUEUE_STACK_SIZE
+    int "Stack size (bytes) for the dedicated kscan workqueue thread."
+    default 1536
+    depends on ZMK_KSCAN_DEDICATED_WORKQUEUE
+    help
+        Must cover the scan handler plus the input GPIO driver it calls into
+        (for I2C expanders, the I2C transfer path). 1536 is comfortable.
+
+config ZMK_KSCAN_DEDICATED_WORKQUEUE_PRIORITY
+    int "Thread priority for the dedicated kscan workqueue."
+    default -2
+    depends on ZMK_KSCAN_DEDICATED_WORKQUEUE
+    help
+        Should sit one step above the system workqueue (default -1) so a busy
+        system workqueue cannot delay a scan, and WELL below the BLE controller.
+        Note the radio link layer is ISR-driven, so no thread priority can
+        disrupt it; this only orders the scan against other threads.
+
 config ZMK_KSCAN_DEBOUNCE_PRESS_MS
